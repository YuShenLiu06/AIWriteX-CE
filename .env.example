# AIWriteX Docker 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ============================================================================
# 认证配置
# ============================================================================
# Basic Auth 用户名（默认: admin）
AIWRITEX_AUTH_USER=admin

# Basic Auth 密码（必填，请设置强密码）
AIWRITEX_AUTH_PASSWORD=your_secure_password_here

# API 密钥（可选，用于 API 调用时的 X-API-Key 头认证）
AIWRITEX_AUTH_API_KEY=your_optional_api_key_here

# CORS 允许的源（逗号分隔）
AIWRITEX_CORS_ORIGINS=http://localhost:3000,http://localhost:8888

# ============================================================================
# 服务器配置
# ============================================================================
# 服务端口（默认: 8888）
AIWRITEX_PORT=8888

# ============================================================================
# LLM API 密钥
# ============================================================================
# 根据你使用的 LLM 提供商，配置相应的 API 密钥

# OpenRouter (支持多种模型)
OPENROUTER_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# ============================================================================
# 微信公众号（可选，用于自动发布）
# ============================================================================
# 微信 AppID
WECHAT_APPID=

# 微信 AppSecret
WECHAT_APPSECRET=

# 微信作者名称
WECHAT_AUTHOR=

# ============================================================================
# 其他配置（可选）
# ============================================================================
# 日志级别 (debug, info, warning, error)
AIWRITEX_LOG_LEVEL=info

# 是否自动发布
AUTO_PUBLISH=false

# 文章格式 (html, markdown, text)
ARTICLE_FORMAT=html
